# Normalize source code before commits
.gitattributes text eol=lf
*.lua eol=lf 
*.md  text eol=lf
*.txt eol=lf 
*.ot* eol=lf
# minimapa (OTMM) e binario: sem conversao de fim de linha (a regra acima o estragava)
*.otmm binary
*.cpp eol=lf 
*.h   eol=lf 

# Patches do vcpkg precisam de LF (CRLF quebra o git apply)
*.patch text eol=lf
