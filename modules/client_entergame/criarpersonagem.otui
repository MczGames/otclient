CriarPersonagemWindow < MainWindow
  id: criarPersonagemWindow
  !text: tr('Criar personagem')
  size: 560 380
  @onEnter: CriarPersonagem.confirmar()
  @onEscape: CriarPersonagem.fechar()

  // Lado esquerdo: arte do personagem (anda e gira sozinha) e troca de visual
  // Imagens: data/images/criar_personagem/ (tools/assets/gerar_arte_criacao.py)
  Panel
    id: painelArte
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: botaoCriar.top
    width: 210
    margin-bottom: 10
    image-source: /images/ui/panel_flat
    image-border: 1
    border-width: 1
    border-color: #00000077

    UIWidget
      id: arte
      size: 160 160
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 14
      image-fixed-ratio: true
      image-smooth: false
      phantom: true

    Button
      id: visualAnterior
      text: <
      size: 24 22
      anchors.left: parent.left
      anchors.top: arte.bottom
      margin-left: 8
      margin-top: 12
      @onClick: CriarPersonagem.trocarVisual(-1)

    Button
      id: visualProximo
      text: >
      size: 24 22
      anchors.right: parent.right
      anchors.top: arte.bottom
      margin-right: 8
      margin-top: 12
      @onClick: CriarPersonagem.trocarVisual(1)

    Label
      id: nomeVisual
      anchors.left: visualAnterior.right
      anchors.right: visualProximo.left
      anchors.verticalCenter: visualAnterior.verticalCenter
      text-align: center
      color: #e8d8a0

    Label
      id: contadorVisual
      anchors.top: visualAnterior.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      text-align: center
      color: #a0a0a0
      font: verdana-11px-rounded

    Button
      id: girar
      !text: tr('Girar')
      width: 70
      anchors.top: contadorVisual.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      @onClick: CriarPersonagem.girar()

  // Lado direito: nome, sexo e descricao
  Label
    !text: tr('Nome do personagem') .. ':'
    id: rotuloNome
    anchors.top: parent.top
    anchors.left: painelArte.right
    margin-left: 14
    text-auto-resize: true

  TextEdit
    id: campoNome
    anchors.top: rotuloNome.bottom
    anchors.left: rotuloNome.left
    anchors.right: parent.right
    margin-top: 4
    max-length: 20

  Label
    id: rotuloSexo
    !text: tr('Sexo') .. ':'
    anchors.top: campoNome.bottom
    anchors.left: rotuloNome.left
    margin-top: 10
    text-auto-resize: true

  CheckBoxCircle
    id: sexoMasculino
    !text: tr('Masculino')
    anchors.top: rotuloSexo.bottom
    anchors.left: rotuloNome.left
    margin-top: 6
    width: 100

  CheckBoxCircle
    id: sexoFeminino
    !text: tr('Feminino')
    anchors.top: sexoMasculino.top
    anchors.left: sexoMasculino.right
    margin-left: 10
    width: 100

  Label
    id: rotuloDescricao
    !text: tr('Sobre este personagem') .. ':'
    anchors.top: sexoMasculino.bottom
    anchors.left: rotuloNome.left
    margin-top: 14
    text-auto-resize: true

  Panel
    id: painelDescricao
    anchors.top: rotuloDescricao.bottom
    anchors.left: rotuloNome.left
    anchors.right: parent.right
    anchors.bottom: botaoCriar.top
    margin-top: 4
    margin-bottom: 10
    padding: 8
    image-source: /images/ui/panel_flat
    image-border: 1
    border-width: 1
    border-color: #00000077

    Label
      id: descricao
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text-wrap: true
      text-auto-resize: true
      color: #dcdcdc

    Label
      id: aviso
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      text-wrap: true
      text-auto-resize: true
      color: #9fb7d8
      font: verdana-11px-rounded

  Label
    id: mensagem
    anchors.left: parent.left
    anchors.right: botaoCriar.left
    anchors.verticalCenter: botaoCriar.verticalCenter
    margin-right: 10
    color: #ff7070
    text-wrap: true

  Button
    id: botaoCriar
    !text: tr('Criar')
    width: 80
    anchors.right: botaoCancelar.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: CriarPersonagem.confirmar()

  Button
    id: botaoCancelar
    !text: tr('Cancelar')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CriarPersonagem.fechar()
