PassivaIcone < UIWidget
  size: 36 36
  image-smooth: false
  phantom: true

PassivaLinha < UIWidget
  height: 46
  background-color: alpha
  focusable: false
  $hover:
    background-color: #ffffff12
  $on:
    background-color: #f2c14e22

  PassivaIcone
    id: icone
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  Label
    id: nome
    anchors.left: icone.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 5
    text-auto-resize: true
    color: #ffffff

  Label
    id: nivel
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 8
    text-auto-resize: true
    color: #9fa6b2

  Button
    id: slot2
    !text: tr('Espaco 2')
    width: 70
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6

  Button
    id: slot1
    !text: tr('Espaco 1')
    width: 70
    anchors.right: slot2.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4

  Label
    id: desc
    anchors.left: icone.right
    anchors.top: nome.bottom
    anchors.right: slot1.left
    margin-left: 8
    margin-top: 3
    margin-right: 6
    height: 16
    color: #c8ccd4

PassivaEquipada < UIWidget
  height: 46
  background-color: #00000050
  border-width: 1
  border-color: #6a5cff80

  PassivaIcone
    id: icone
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5

  Label
    id: espaco
    anchors.left: icone.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 6
    text-auto-resize: true
    color: #9fa6b2

  Button
    id: tirar
    !text: tr('Remover')
    width: 70
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6

  Label
    id: texto
    anchors.left: icone.right
    anchors.top: espaco.bottom
    anchors.right: tirar.left
    margin-left: 8
    margin-top: 3
    margin-right: 6
    color: #f2c14e

MainWindow
  id: passivasWindow
  !text: tr('Passivas')
  size: 560 580
  @onEscape: fechar()

  Label
    id: titulo
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-wrap: true
    !text: tr('Escolha ate 2 passivas. Elas liberam com o nivel e valem para todas as classes. Use os botoes Espaco 1 e Espaco 2, ou de dois cliques na passiva.')
    color: #c8ccd4

  PassivaEquipada
    id: equipada1
    anchors.top: titulo.bottom
    anchors.left: parent.left
    width: 256
    margin-top: 8

  PassivaEquipada
    id: equipada2
    anchors.top: titulo.bottom
    anchors.right: parent.right
    width: 256
    margin-top: 8

  Label
    id: recarga
    anchors.top: equipada1.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    height: 14
    text-align: center
    color: #9fa6b2

  Button
    id: fecharBotao
    !text: tr('Fechar')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: fechar()

  Label
    id: mensagem
    anchors.left: parent.left
    anchors.right: fecharBotao.left
    anchors.verticalCenter: fecharBotao.verticalCenter
    margin-right: 8
    color: #9fa6b2

  VerticalScrollBar
    id: barra
    anchors.top: recarga.bottom
    anchors.bottom: fecharBotao.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 6
    step: 48
    pixels-scroll: true

  ScrollablePanel
    id: lista
    anchors.top: recarga.bottom
    anchors.left: parent.left
    anchors.right: barra.left
    anchors.bottom: fecharBotao.top
    margin-top: 6
    margin-bottom: 6
    vertical-scrollbar: barra
    layout:
      type: verticalBox
      spacing: 2
