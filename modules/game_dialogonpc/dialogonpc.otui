DialogoOpcao < Button
  height: 24
  margin-top: 4
  text-align: left
  text-offset: 10 0
  anchors.left: parent.left
  anchors.right: parent.right

MainWindow
  id: dialogoNpcWindow
  !text: 'Conversa'
  width: 420
  height: 200
  @onEscape: fechar()

  UIWidget
    id: cartao
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 76
    background-color: #162338
    border-width: 1
    border-color: #272727

    Creature
      id: retrato
      size: 64 64
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      image-source: ""
      image-border: 0
      phantom: true

    Label
      id: nome
      font: Verdana Bold-11px
      anchors.left: retrato.right
      anchors.top: parent.top
      anchors.right: parent.right
      margin-left: 10
      margin-top: 8
      color: #ffd27a
      phantom: true

    Label
      id: texto
      anchors.left: retrato.right
      anchors.top: nome.bottom
      anchors.right: parent.right
      margin-left: 10
      margin-top: 4
      margin-right: 10
      text-wrap: true
      text-auto-resize: true
      color: #ffffff
      phantom: true

  UIWidget
    id: opcoes
    anchors.top: cartao.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 10
    layout:
      type: verticalBox
      fit-children: true
